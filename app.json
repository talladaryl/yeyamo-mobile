{
  "expo": {
    "name": "yeyamo-mobile",
    "slug": "yeyamo-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "yeyamo",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yeyamo.mobile",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Yeyamo uses your location to show nearby places and events.",
        "NSCameraUsageDescription": "Yeyamo needs camera access to create posts and stories.",
        "NSMicrophoneUsageDescription": "Yeyamo needs microphone access to record videos.",
        "NSPhotoLibraryUsageDescription": "Yeyamo needs photo library access to upload media.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.yeyamo.mobile",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Yeyamo needs photo access to upload media.",
          "cameraPermission": "Yeyamo needs camera access to create posts."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Yeyamo uses location to show nearby events."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Yeyamo needs camera access.",
          "microphonePermission": "Yeyamo needs microphone to record video."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#7C3AED"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "2f6d01b6-cd01-4abb-bd82-c261fc7fb151"
      }
    }
  }
}
