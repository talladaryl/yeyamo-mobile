# Copiez ce fichier vers .env.local dans le dépôt yeyamo-mobile.
# iOS Simulator / Expo Web sur la même machine :
EXPO_PUBLIC_API_BASE_URL=auto
EXPO_PUBLIC_MESSAGING_WS_URL=auto

# Clé Google Maps réservée à Android. Laissez vide tant qu'aucune clé locale
# restreinte à l'application Android n'est configurée.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_IOS_API_KEY=

# Valeurs publiques OAuth, à créer dans Google Cloud Console pour chaque plateforme.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Clé publique Cloudflare Turnstile associée aux origines autorisées de l'application.
EXPO_PUBLIC_TURNSTILE_SITE_KEY=

# Android Emulator : remplacez 127.0.0.1 par 10.0.2.2.
# Appareil physique : remplacez 127.0.0.1 par l'IPv4 LAN du PC
# (par exemple 192.168.1.25) et autorisez les ports 8083/8104 dans le pare-feu.

# Les mocks ne sont pas globaux : seuls les deux boutons « compte démo »
# ouvrent une session de démonstration. Une connexion/inscription normale
# utilise toujours EXPO_PUBLIC_API_BASE_URL.
EXPO_PUBLIC_APP_ENV=development
